# libreoffice-mcp environment configuration
# Copy to .env or export in your shell profile / Hermes env block.

# Path to the LibreOffice headless binary. On Windows use the console variant
# soffice.com (soffice.exe is a GUI launcher that won't return cleanly from a shell).
# Default: "libreoffice" (resolved from PATH)
LIBREOFFICE_PATH=

# Default working directory for documents the server creates.
# Default: ~/Documents/libreoffice-mcp
LIBREOFFICE_MCP_WORKING_DIR=

# Default author name/initials for comments and tracked changes.
# Default: "AI Assistant" / "AI"
LIBREOFFICE_MCP_AUTHOR_NAME=
LIBREOFFICE_MCP_AUTHOR_INITIALS=

# Seconds before a LibreOffice conversion call times out.
# Default: 30
LIBREOFFICE_MCP_CONVERSION_TIMEOUT=